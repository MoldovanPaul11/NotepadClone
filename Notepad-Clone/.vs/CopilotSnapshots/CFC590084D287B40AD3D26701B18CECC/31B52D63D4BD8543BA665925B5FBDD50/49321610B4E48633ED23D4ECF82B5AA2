<Window x:Class="Tema1_MVP.Views.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tema1_MVP.ViewModels"
        Title="Find / Replace"
        Width="440" Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="#1E1E2E">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Find -->
        <Label Grid.Row="0" Grid.Column="0" Content="Find:"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Replace -->
        <Label Grid.Row="1" Grid.Column="0" Content="Replace:"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4"
                 Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Scope radio buttons -->
        <Label Grid.Row="2" Grid.Column="0" Content="Scope:"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6" Spacing="16">
            <RadioButton Content="Selected tab"
                         IsChecked="{Binding SearchInAllTabs, Converter={StaticResource InverseBooleanConverter}}"/>
            <RadioButton Content="All tabs"
                         IsChecked="{Binding SearchInAllTabs}"/>
        </StackPanel>

        <!-- Go to line -->
        <Label Grid.Row="3" Grid.Column="0" Content="Go to line:"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4" Spacing="6">
            <TextBox Width="80"
                     Text="{Binding GoToLine, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Go" Click="GoToLine_Click" Padding="8,4"/>
        </StackPanel>

        <!-- Action buttons -->
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0" Spacing="8">
            <Button Content="Find Next"    Command="{Binding FindCommand}"
                    Click="Find_Click"/>
            <Button Content="Replace"      Command="{Binding ReplaceCommand}"/>
            <Button Content="Replace All"  Command="{Binding ReplaceAllCommand}"/>
            <Button Content="Close"        Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

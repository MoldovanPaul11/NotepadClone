<Window x:Class="Tema1_MVP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tema1_MVP.ViewModels"
        xmlns:conv="clr-namespace:Tema1_MVP.Converters"
        mc:Ignorable="d"
        Title="Notepad++ Clone"
        Height="700" Width="1100"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Toolbar/Menu dark style -->
        <Style x:Key="DarkMenuStyle" TargetType="Menu">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="#181825"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#45475A"/>
        </Style>
        <Style TargetType="ToolBar">
            <Setter Property="Background" Value="#181825"/>
        </Style>
        <Style x:Key="ToolBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Tab header template -->
        <DataTemplate x:Key="TabHeaderTemplate" DataType="{x:Type vm:DocumentViewModel}">
            <TextBlock Text="{Binding TabHeader}"
                       Foreground="{Binding IsModified, Converter={StaticResource ModifiedToBrushConverter}}"
                       ToolTip="{Binding FilePath}"/>
        </DataTemplate>
        <!-- Tree item template with context menu -->
        <HierarchicalDataTemplate x:Key="TreeItemTemplate"
                                  DataType="{x:Type vm:FileTreeItemViewModel}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" Foreground="#CDD6F4" Padding="2,1">
                <TextBlock.ContextMenu>
                    <ContextMenu Background="#313244" BorderBrush="#45475A">
                        <MenuItem Header="📄 New File"
                                  Command="{Binding DataContext.TreeNewFileCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                  Visibility="{Binding IsDirectory,
                                               Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <MenuItem Header="📋 Copy Path"
                                  Command="{Binding DataContext.TreeCopyPathCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <MenuItem Header="📁 Copy Folder"
                                  Command="{Binding DataContext.TreeCopyFolderCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                  Visibility="{Binding IsDirectory,
                                               Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <MenuItem Header="📥 Paste Folder Here"
                                  Command="{Binding DataContext.TreePasteFolderCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                  Visibility="{Binding IsDirectory,
                                               Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Separator/>
                        <MenuItem Header="📂 Open File"
                                  Command="{Binding DataContext.TreeOpenFileCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                  Visibility="{Binding IsDirectory,
                                               Converter={StaticResource BoolToVisibilityConverter},
                                               ConverterParameter=Inverse}"/>
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ═══════════════ MENU BAR ═══════════════ -->
        <Menu DockPanel.Dock="Top" Style="{StaticResource DarkMenuStyle}">

            <!-- File -->
            <MenuItem Header="_File">
                <MenuItem Header="🆕 _New"       Command="{Binding NewCommand}"          InputGestureText="Ctrl+N"/>
                <MenuItem Header="📂 _Open..."    Command="{Binding OpenCommand}"         InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="💾 _Save"       Command="{Binding SaveCommand}"         InputGestureText="Ctrl+S"/>
                <MenuItem Header="💾 Save _As..." Command="{Binding SaveAsCommand}"       InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="❌ _Close"      Command="{Binding CloseCurrentCommand}" InputGestureText="Ctrl+W"/>
                <MenuItem Header="❌ Close All"   Command="{Binding CloseAllCommand}"/>
                <Separator/>
                <MenuItem Header="🚪 E_xit"       Command="{Binding ExitCommand}"         InputGestureText="Alt+F4"/>
            </MenuItem>

            <!-- Search -->
            <MenuItem Header="_Search">
                <MenuItem Header="🔍 _Find..."        Command="{Binding FindCommand}"      InputGestureText="Ctrl+F"/>
                <MenuItem Header="🔄 _Replace..."     Command="{Binding FindCommand}"      InputGestureText="Ctrl+H"/>
                <Separator/>
                <MenuItem Header="Scope">
                    <MenuItem.Template>
                        <ControlTemplate TargetType="MenuItem">
                            <StackPanel Orientation="Horizontal" Margin="8,4">
                                <TextBlock Text="Scope: " Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                <RadioButton Content="Current tab"
                                             IsChecked="{Binding SearchInAllTabs,
                                                          Converter={StaticResource InverseBooleanConverter}}"
                                             Foreground="#CDD6F4" Margin="4,0"/>
                                <RadioButton Content="All tabs"
                                             IsChecked="{Binding SearchInAllTabs}"
                                             Foreground="#CDD6F4" Margin="4,0"/>
                            </StackPanel>
                        </ControlTemplate>
                    </MenuItem.Template>
                </MenuItem>
            </MenuItem>

            <!-- View -->
            <MenuItem Header="_View">
                <MenuItem Header="📐 Standard (hide explorer)"
                          Command="{Binding ToggleFolderExplorerCommand}"/>
                <MenuItem Header="🌳 Folder Explorer (toggle)"
                          Command="{Binding ToggleFolderExplorerCommand}"/>
                <Separator/>
                <MenuItem Header="📁 Open Folder..."
                          Command="{Binding OpenFolderCommand}"/>
            </MenuItem>

            <!-- Edit (bonus) -->
            <MenuItem Header="_Edit">
                <MenuItem Header="📋 Copy"      Command="{Binding CopyCommand}"    InputGestureText="Ctrl+C"/>
                <MenuItem Header="✂️ Cut"       Command="{Binding CutCommand}"     InputGestureText="Ctrl+X"/>
                <MenuItem Header="📌 Paste"     Command="{Binding PasteCommand}"   InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header="🔠 To UPPER"  Command="{Binding ToUpperCommand}"/>
                <MenuItem Header="🔡 To lower"  Command="{Binding ToLowerCommand}"/>
                <Separator/>
                <MenuItem Header="➡️ Go to Line..." Command="{Binding FindCommand}"/>
            </MenuItem>

            <!-- Help -->
            <MenuItem Header="_Help">
                <MenuItem Header="ℹ️ About..."   Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ═══════════════ TOOLBAR ═══════════════ -->
        <ToolBar DockPanel.Dock="Top" Background="#181825" Foreground="#CDD6F4">
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding NewCommand}"   ToolTip="New (Ctrl+N)"  Content="🆕"/>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding OpenCommand}"  ToolTip="Open (Ctrl+O)" Content="📂"/>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding SaveCommand}"  ToolTip="Save (Ctrl+S)" Content="💾"/>
            <Separator Background="#45475A"/>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding CloseCurrentCommand}" ToolTip="Close tab (Ctrl+W)" Content="❌"/>
            <Separator Background="#45475A"/>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding FindCommand}"  ToolTip="Find/Replace (Ctrl+F)" Content="🔍"/>
            <Separator Background="#45475A"/>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding CopyCommand}"  ToolTip="Copy" Content="📋"/>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding CutCommand}"   ToolTip="Cut"  Content="✂️"/>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding PasteCommand}" ToolTip="Paste" Content="📌"/>
            <Separator Background="#45475A"/>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding ToUpperCommand}" ToolTip="To UPPER" Content="🔠"/>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding ToLowerCommand}" ToolTip="To lower" Content="🔡"/>
            <Separator Background="#45475A"/>
            <Button Style="{StaticResource ToolBarButtonStyle}"
                    Command="{Binding ToggleFolderExplorerCommand}"
                    ToolTip="Toggle Folder Explorer" Content="🌳"/>
        </ToolBar>

        <!-- ═══════════════ STATUS BAR ═══════════════ -->
        <StatusBar DockPanel.Dock="Bottom" Background="#181825">
            <StatusBarItem>
                <TextBlock Foreground="#6C7086"
                           Text="{Binding SelectedDocument.FilePath,
                                  FallbackValue='No file selected', TargetNullValue='New file (unsaved)'}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Foreground="#6C7086"
                           Text="{Binding SelectedDocument.IsModified,
                                  StringFormat='Modified: {0}', FallbackValue=''}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ═══════════════ MAIN CONTENT GRID ═══════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Folder Explorer panel (collapsible) -->
                <ColumnDefinition Width="{Binding IsFolderExplorerVisible,
                                           Converter={StaticResource BoolToGridLengthConverter}}"
                                  MinWidth="0"/>
                <ColumnDefinition Width="4"/>
                <!-- Editor area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Folder Explorer ─── -->
            <Border Grid.Column="0"
                    Background="#181825"
                    BorderBrush="#313244" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsFolderExplorerVisible,
                                 Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="  📁 Folder Explorer"
                               Background="#313244"
                               Foreground="#89DCEB"
                               FontWeight="SemiBold"
                               Padding="4,6"/>
                    <Button DockPanel.Dock="Top"
                            Content="+ Open Folder"
                            Command="{Binding OpenFolderCommand}"
                            Background="#313244"
                            Foreground="#A6E3A1"
                            BorderThickness="0"
                            Padding="6,4"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"/>
                    <TreeView Background="#181825"
                              BorderThickness="0"
                              ItemsSource="{Binding TreeRoots}"
                              ItemTemplate="{StaticResource TreeItemTemplate}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              MouseDoubleClick="TreeView_MouseDoubleClick">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- ─── Splitter ─── -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="#313244"
                          Visibility="{Binding IsFolderExplorerVisible,
                                       Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- ─── Tab Editor Area ─── -->
            <TabControl Grid.Column="2"
                        x:Name="MainTabControl"
                        ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                        Background="#1E1E2E"
                        BorderBrush="#313244"
                        ContentTemplate="{StaticResource TabHeaderTemplate}">

                <!-- Tab header -->
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <TextBlock Text="{Binding TabHeader}"
                                       Foreground="{Binding IsModified,
                                                    Converter={StaticResource ModifiedToBrushConverter}}"
                                       ToolTip="{Binding FilePath}"
                                       Margin="0,0,4,0"/>
                            <!-- Close button on tab -->
                            <Button Content="✕"
                                    FontSize="9"
                                    Padding="2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#6C7086"
                                    Cursor="Hand"
                                    Tag="{Binding}"
                                    Click="TabCloseButton_Click"
                                    ToolTip="Close tab"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <!-- Tab content = text editor -->
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                        <TextBox x:Name="EditorTextBox"
                                 Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas, Courier New"
                                 FontSize="14"
                                 Background="#1E1E2E"
                                 Foreground="#CDD6F4"
                                 CaretBrush="#CDD6F4"
                                 SelectionBrush="#45475A"
                                 BorderThickness="0"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 SpellCheck.IsEnabled="False"
                                 Padding="8"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>

            </TabControl>
        </Grid>
    </DockPanel>

    <!-- Keyboard shortcuts -->
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl"       Command="{Binding NewCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl"       Command="{Binding OpenCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl"       Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl"       Command="{Binding CloseCurrentCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl"       Command="{Binding FindCommand}"/>
        <KeyBinding Key="H" Modifiers="Ctrl"       Command="{Binding FindCommand}"/>
    </Window.InputBindings>

</Window>
